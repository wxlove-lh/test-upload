SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
DATABASE_URL=sqlite:///dev.db

# ── AI 配置（不配置也能用：记账/查账/报表/报税都正常，只有"图片识别"和"AI聊天"不可用） ──
# 1) API Key：OpenAI 兼容接口都行（DeepSeek / Kimi / 通义 / 智谱等）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# 2) 接口地址（默认 DeepSeek 官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 3) 文字对话模型（deepseek-chat 是纯文本模型，适合 AI 聊天/底稿解读）
DEEPSEEK_MODEL=deepseek-chat
# 4) 看图模型（识别小票专用）：官方 deepseek-chat 不支持图片，
#    需要填一个"支持图片输入"的模型名，例如接入视觉模型的兼容接口。
#    具体可用模型以各家官方文档为准【待核实】
DEEPSEEK_VISION_MODEL=

